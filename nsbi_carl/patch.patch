+"""Transformer architecture: stacked/vmap path agrees with standalone CARL.
+
+Checks, on CPU with tiny shapes:
+  * a CARL built with architecture="transformer" runs forward/backward
+  * StackedTransformer.init_from_seeds reproduces the standalone init
+  * the stacked forward (per-member and shared input) matches each member
+  * per-member gradients are independent (disjoint parameter slices)
+  * member_state_dict loads back into CARL, and stack_trained_members
+    rebuilds an identical stack from those members
+  * no batched outer-product matmul is dispatched (see backward_test.py)
+  * old DNN hparams without an "architecture" key still build a DNN
+  * end to end through the Pipeline with model.architecture: transformer --
+    vectorized, process-pool, k-fold and single-network training, and the
+    EnsembleScorer used by the likelihood fit
+"""
+import shutil
+import sys
+import tempfile
+from pathlib import Path
+
+import numpy as np
+import torch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from nsbi_carl.model import CARL, architecture_hparams  # noqa: E402
+from nsbi_carl.training.vectorized import (  # noqa: E402
+    StackedMLP,
+    StackedTransformer,
+    build_stacked,
+    stack_trained_members,
+)
+from backward_test import CatchOuterProductBmm  # noqa: E402
+
+TF = dict(tf_d_model=16, tf_n_heads=4, tf_n_layers=2, tf_ff_dim=32)
+
+
+def make_carl(n_features, seed):
+    torch.manual_seed(seed)
+    return CARL(n_features, architecture="transformer", **TF).eval()
+
+
+def main():
+    M, B, Fdim = 3, 50, 4
+    seeds = [7, 8, 9]
+
+    # -- standalone model ------------------------------------------------
+    carl = make_carl(Fdim, seeds[0])
+    x = torch.randn(B, Fdim)
+    out = carl.net(x)
+    assert out.shape == (B, 1), out.shape
+    out.sum().backward()
+    assert all(p.grad is not None for p in carl.parameters())
+
+    # -- stacked init == standalone init ---------------------------------
+    stacked = StackedTransformer(M, Fdim, d_model=16, n_heads=4, n_layers=2, ff_dim=32)
+    stacked.init_from_seeds(seeds)
+    members = [make_carl(Fdim, s) for s in seeds]
+    for m, member in enumerate(members):
+        sd = stacked.member_state_dict(m)
+        for k, v in member.state_dict().items():
+            torch.testing.assert_close(sd[k], v, msg=f"init mismatch {k}")
+
+    # -- forward agreement -------------------------------------------------
+    stacked.eval()
+    xm = torch.randn(M, B, Fdim)
+    with torch.no_grad():
+        per = stacked(xm)
+        shared = stacked(x)
+    assert per.shape == (M, B) and shared.shape == (M, B)
+    for m, member in enumerate(members):
+        with torch.no_grad():
+            torch.testing.assert_close(per[m], member.net(xm[m]).squeeze(-1), atol=1e-5, rtol=1e-5)
+            torch.testing.assert_close(shared[m], member.net(x).squeeze(-1), atol=1e-5, rtol=1e-5)
+
+    # -- member independence + no outer-product bmm -------------------------
+    stacked.train()
+    with CatchOuterProductBmm() as guard:
+        logits = stacked(xm)
+        logits[1].sum().backward()
+    assert not guard.offenders, guard.offenders
+    for name, p in stacked.params.items():
+        g = p.grad
+        assert g[0].abs().max() == 0 and g[2].abs().max() == 0, f"{name}: gradient leaked across members"
+
+    # -- export / re-stack round trip ---------------------------------------
+    restored = []
+    for m in range(M):
+        c = CARL(Fdim, architecture="transformer", **TF)
+        c.load_state_dict(stacked.member_state_dict(m))
+        restored.append(c.eval())
+    again = stack_trained_members(restored)
+    assert isinstance(again, StackedTransformer)
+    with torch.no_grad():
+        torch.testing.assert_close(again(xm), stacked.eval()(xm))
+
+    # -- backward compatibility ----------------------------------------------
+    old_hp = {"n_features": Fdim, "n_layers": 2, "n_nodes": 8, "dropout": 0.0}
+    assert architecture_hparams(old_hp)["architecture"] == "dnn"
+    assert isinstance(build_stacked(2, Fdim, hp=old_hp), StackedMLP)
+
+    pipeline_checks()
+    print("transformer_test: OK")
+
+
+def pipeline_checks():
+    from nsbi_carl import Pipeline
+    from nsbi_carl.inference import EnsembleScorer, read_record
+    from smoke_test import build_config
+
+    tf_model = {"architecture": "transformer",
+                "transformer": {"d_model": 16, "n_heads": 2, "n_layers": 1, "ff_dim": 32}}
+    tmp = Path(tempfile.mkdtemp(prefix="nsbi_tf_"))
+    try:
+        x = torch.randn(400, 2)
+        for mode in ("vectorized", "process"):
+            cfg = build_config(tmp, f"tf_{mode}")
+            cfg["ensemble"]["mode"] = mode
+            cfg["training"]["max_epochs"] = 2
+            cfg["model"] = tf_model
+            ens = Pipeline(cfg).run()["ensemble"]
+            assert len(ens.models) == 3
+            assert all(m.hparams["architecture"] == "transformer" for m in ens.models)
+            stacked = ens.member_predictions(x, device="cpu", stacked=True)
+            looped = ens.member_predictions(x, device="cpu", stacked=False)
+            dev = float(np.abs(stacked - looped).max())
+            assert dev < 1e-5, f"{mode}: stacked vs looped differ by {dev}"
+            print(f"[ok] transformer {mode} ensemble (stacked vs looped {dev:.1e})")
+
+            rec = read_record(tmp / f"out_tf_{mode}", f"smoke_tf_{mode}")
+            scorer = EnsembleScorer(rec, device="cpu")
+            xr = np.random.default_rng(0).normal(0, 1, (300, 2))
+            got = scorer.score(xr)
+            xs = torch.as_tensor(scorer.scale(xr), dtype=torch.float32)
+            with torch.no_grad():
+                want = np.mean([m(xs).flatten().numpy() for m in scorer.models], axis=0)
+            assert float(np.abs(got - want).max()) < 1e-5
+            print(f"[ok] transformer {mode}: EnsembleScorer matches per-member mean")
+
+        cfg = build_config(tmp, "tf_kfold")
+        cfg["split"]["k_folds"] = 2
+        cfg["ensemble"]["n_members"] = 2
+        cfg["training"]["max_epochs"] = 2
+        cfg["model"] = tf_model
+        ens = Pipeline(cfg).run()["ensemble"]
+        assert len(ens.models) == 4
+        print("[ok] transformer k-fold ensemble")
+
+        cfg = build_config(tmp, "tf_single", ensemble=False)
+        cfg["training"]["max_epochs"] = 2
+        cfg["model"] = tf_model
+        res = Pipeline(cfg).run()
+        assert res["summaries"][0]["val_loss"]
+        print("[ok] transformer single network")
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    main()
